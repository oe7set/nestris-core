# /etc/nestris-station/env  (root:nestris, mode 0640)
# Loaded by the systemd unit. Any config key can be overridden here as
# NESTRIS_STATION__<SECTION>__<KEY>=value.

# MQTT password (keeps it out of station.toml):
#NESTRIS_STATION__MQTT__PASSWORD=change-me

# Per-machine overrides without editing station.toml:
#NESTRIS_STATION__STATION__ID=station-2
#NESTRIS_STATION__MQTT__HOST=192.168.1.10

# Log filter (overrides [log] level), e.g. debug output of the RFID reader:
#RUST_LOG=info,nestris_station::rfid=debug
